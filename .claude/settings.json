{
  "$schema_comment": "Hooks que automatizan la verificación. El harness los ejecuta, no el agente, así que no se pueden saltar. No hay tests: tras editar se comprueba que el proyecto compila; al terminar, el leader (Stop) y el spec_author pasan ./init.sh --quick, y el implementer ./init.sh completo.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edit.sh",
            "timeout": 180,
            "statusMessage": "Comprobando que compila..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/init-check.sh --quick",
            "timeout": 60,
            "statusMessage": "Ejecutando ./init.sh --quick..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^spec_author$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/init-check.sh --quick",
            "timeout": 60,
            "statusMessage": "Ejecutando ./init.sh --quick..."
          }
        ]
      },
      {
        "matcher": "^implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/init-check.sh",
            "timeout": 600,
            "statusMessage": "Ejecutando ./init.sh..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./init.sh*)",
      "Bash(cargo check*)",
      "Bash(cargo fmt*)",
      "Bash(cargo clippy*)",
      "Bash(npm run lint*)",
      "Bash(npx tsc -b*)",
      "Bash(./verifications/*/auto.sh)",
      "Bash(chmod +x verifications/*/auto.sh)",
      "Edit(/feature_list.json)",
      "Edit(/progress/**)",
      "Edit(/specs/**)",
      "Edit(/verifications/**)"
    ],
    "deny": [
      "Bash(git push*)"
    ]
  }
}
