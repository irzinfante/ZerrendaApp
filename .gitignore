## app
# Logs
app/logs
app/*.log
app/npm-debug.log*
app/yarn-debug.log*
app/yarn-error.log*
app/pnpm-debug.log*
app/lerna-debug.log*

app/node_modules
app/dist
app/dist-ssr
app/*.tsbuildinfo
app/*.local
app/.env

# Editor directories and files
app/.vscode/*
app/!.vscode/extensions.json
app/.idea
app/.DS_Store
app/*.suo
app/*.ntvs*
app/*.njsproj
app/*.sln
app/*.sw?

## api
# Generated by Cargo
# will have compiled files and executables
api/debug/
api/target/

# These are backup files generated by rustfmt
api/**/*.rs.bk
# MSVC Windows builds of rustc generate these, which store debugging information
api/*.pdb
# RustRover
api/.idea/

# Environment variables file
api/.env

## database
db/data